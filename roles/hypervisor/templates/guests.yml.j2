# Generated by site.yml; add service-specific variables in your own inventory.
all:
  vars:
    ansible_user: {{ lab_user }}
    ansible_ssh_common_args: '-o ProxyJump={{ ansible_user }}@{{ ansible_host }} -o StrictHostKeyChecking=accept-new'
  children:
{% for role in ['router', 'clickhouse', 'load'] %}
    {{ role }}:
      hosts:
{% for node in lab_vms if node.role == role %}
        {{ node.name }}:
          ansible_host: {{ node.ip }}
          dc: {{ node.dc }}
{% if node.role == 'clickhouse' %}
{% if node.keeper | default(false) %}
          keeper: true
{% endif %}
          shard: {{ node.shard }}
          replica: {{ node.replica }}
          raid_level: {{ node.raid_level }}
          data_disks: [vdb, vdc, vdd, vde]
{% endif %}
{% endfor %}
{% endfor %}
