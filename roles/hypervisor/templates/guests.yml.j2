# Generated by site.yml; add service-specific variables in your own inventory.
all:
  vars:
    ansible_user: {{ lab_user }}
    ansible_ssh_common_args: '-o ProxyJump={{ ansible_user }}@{{ ansible_host }} -o StrictHostKeyChecking=accept-new'
  children:
{% for role in ['router', 'clickhouse', 'zookeeper', 'load'] %}
    {{ role }}:
      hosts:
{% for node in lab_vms if node.role == role or (role == 'zookeeper' and node.zookeeper | default(false)) %}
        {{ node.name }}:
          ansible_host: {{ node.ip }}
          dc: {{ node.dc }}
{% if node.clickhouse_instances is defined %}
          clickhouse_instances: {{ node.clickhouse_instances | to_json }}
          zookeeper_id: {{ node.zookeeper_id }}
{% elif node.role == 'clickhouse' %}
          shard: {{ node.shard }}
          replica: {{ node.replica }}
          raid_level: {{ node.raid_level }}
          data_disks: [vdb, vdc, vdd, vde]
{% endif %}
{% endfor %}
{% endfor %}
