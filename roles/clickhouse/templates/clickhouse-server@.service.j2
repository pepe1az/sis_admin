[Unit]
Description=ClickHouse Server (%i)
After=network-online.target clickhouse-keeper.service
Wants=network-online.target

[Service]
Type=simple
User=clickhouse
Group=clickhouse
ExecStart=/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/%i/config.xml
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
