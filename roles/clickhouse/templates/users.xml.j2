<?xml version="1.0"?>
<!-- Managed by Ansible. Не редактировать вручную. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>{{ clickhouse_max_query_memory }}</max_memory_usage>
            <max_threads>{{ clickhouse_max_threads }}</max_threads>
            <log_queries>1</log_queries>
            <log_query_threads>0</log_query_threads>
            <max_bytes_before_external_group_by>268435456</max_bytes_before_external_group_by>
        </default>
    </profiles>

    <users>
        <{{ clickhouse_user }}>
            <!-- sha256 от пароля, сам пароль в git не попадает -->
            <password_sha256_hex>{{ clickhouse_password | hash('sha256') }}</password_sha256_hex>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </{{ clickhouse_user }}>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
