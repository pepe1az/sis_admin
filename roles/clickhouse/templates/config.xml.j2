<?xml version="1.0"?>
<!-- Managed by Ansible. Не редактировать вручную. -->
{% set ports = clickhouse_port_profiles[item.profile] %}
<clickhouse>
    <logger>
        <level>information</level>
        <log>{{ clickhouse_log_root }}/{{ item.name }}/clickhouse-server.log</log>
        <errorlog>{{ clickhouse_log_root }}/{{ item.name }}/clickhouse-server.err.log</errorlog>
        <size>200M</size>
        <count>5</count>
    </logger>

    <!-- ==== Сеть и порты инстанса ======================================== -->
    <listen_host>0.0.0.0</listen_host>
    <http_port>{{ ports.http }}</http_port>
    <tcp_port>{{ ports.tcp }}</tcp_port>
    <mysql_port>{{ ports.mysql }}</mysql_port>
    <interserver_http_port>{{ ports.interserver }}</interserver_http_port>
    <interserver_http_host>{{ clickhouse_node_ip }}</interserver_http_host>
    <listen_backlog>4096</listen_backlog>
    <max_connections>4096</max_connections>
    <keep_alive_timeout>10</keep_alive_timeout>
    <max_concurrent_queries>200</max_concurrent_queries>
    <max_server_memory_usage>{{ clickhouse_max_server_memory }}</max_server_memory_usage>

    <!-- ==== Данные инстанса ============================================ -->
    <path>{{ clickhouse_data_root }}/{{ item.name }}/</path>
    <tmp_path>{{ clickhouse_data_root }}/{{ item.name }}/tmp/</tmp_path>
    <user_files_path>{{ clickhouse_data_root }}/{{ item.name }}/user_files/</user_files_path>
    <format_schema_path>{{ clickhouse_data_root }}/{{ item.name }}/format_schemas/</format_schema_path>
    <timezone>UTC</timezone>
    <mlock_executable>false</mlock_executable>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- ==== Keeper (координация репликации и DDL) ====================== -->
    <zookeeper>
    {% for node in clickhouse_keeper_nodes %}
        <node>
            <host>{{ hostvars[node.host].clickhouse_node_ip }}</host>
            <port>{{ clickhouse_keeper_client_port }}</port>
        </node>
    {% endfor %}
        <session_timeout_ms>30000</session_timeout_ms>
        <operation_timeout_ms>10000</operation_timeout_ms>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
        <replicas_path>/clickhouse/task_queue/replicas</replicas_path>
        <profile>default</profile>
        <pool_size>4</pool_size>
        <cleanup_delay_period>60</cleanup_delay_period>
    </distributed_ddl>

    <!-- ==== Макросы шарда и реплики ==================================== -->
    <macros>
        <cluster>{{ clickhouse_cluster_name }}</cluster>
        <shard>{{ item.shard }}</shard>
        <replica>{{ item.replica }}</replica>
        <dc>{{ item.replica }}</dc>
    </macros>

    <!-- ==== Кластер: 3 шарда x 2 реплики, реплики в разных ДЦ ========== -->
    <remote_servers>
        <{{ clickhouse_cluster_name }}>
        {% for shard in clickhouse_instances | map(attribute='shard') | unique | sort %}
            <shard>
                <!-- Писать в одну реплику, остальные синхронизируются через Keeper -->
                <internal_replication>true</internal_replication>
                <weight>1</weight>
            {% for replica in clickhouse_instances | selectattr('shard', 'equalto', shard) | sort(attribute='replica') %}
                <replica>
                    <host>{{ hostvars[replica.host].clickhouse_node_ip }}</host>
                    <port>{{ clickhouse_port_profiles[replica.profile].tcp }}</port>
                    <!-- Учётные данные для распределённых запросов между шардами -->
                    <user>{{ clickhouse_user }}</user>
                    <password>{{ clickhouse_password | e }}</password>
                </replica>
            {% endfor %}
            </shard>
        {% endfor %}
        </{{ clickhouse_cluster_name }}>
    </remote_servers>

    <!-- ==== Пользователи и доступ ====================================== -->
    <user_directories>
        <users_xml>
            <path>{{ clickhouse_config_root }}/{{ item.name }}/users.xml</path>
        </users_xml>
        <local_directory>
            <path>{{ clickhouse_data_root }}/{{ item.name }}/access/</path>
        </local_directory>
    </user_directories>
    <default_profile>default</default_profile>
    <default_database>default</default_database>

    <!-- ==== Метрики для Prometheus ===================================== -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>{{ ports.prometheus }}</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>

    <!-- ==== Системные логи (нужны для аналитики нагрузки) =============== -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_log>

    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_thread_log>

    <part_log>
        <database>system</database>
        <table>part_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
</clickhouse>
