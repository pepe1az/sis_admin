[Unit]
Description=ClickHouse Server instance %i
Documentation=https://clickhouse.com/docs/
After=time-sync.target network-online.target clickhouse-keeper.service
Wants=time-sync.target network-online.target
Conflicts=clickhouse-server.service

[Service]
Type=notify
User=clickhouse
Group=clickhouse
Environment=CLICKHOUSE_WATCHDOG_NO_FORWARD=1
RuntimeDirectory=clickhouse-server/%i
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/clickhouse-server --config=/etc/clickhouse-server/instances/%i/config.xml --pid-file=%t/clickhouse-server/%i/clickhouse.pid
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=300
LimitNOFILE=500000
LimitCORE=infinity
CapabilityBoundingSet=CAP_NET_ADMIN CAP_IPC_LOCK CAP_SYS_NICE CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_IPC_LOCK CAP_SYS_NICE CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
